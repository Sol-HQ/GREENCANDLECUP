# Helius RPC — TRANSACTION SEND ONLY (never for charts, orderbook, wallet reads, or Rise bootstrap)
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Dedicated read RPC for Rise SDK bootstrap + tx simulation (must NOT be Helius).
# Phoenix candles/orderbook/mark use HTTP API — not this URL.
# READ_RPC_URL=
# TRITON_RPC_URL=
# PHOENIX_READ_RPC_URL=https://api.mainnet-beta.solana.com

# Phoenix API (primary data path — candles, orderbook, mark price)
PHOENIX_API_URL=https://perp-api.phoenix.trade

# Server
PORT=8787
API_KEY=dev
SERVER_POLL_MS=1000
SOLANA_CLUSTER=mainnet-beta
DEFAULT_SYMBOL=SOL

# Triton ShredStream (UDP to this machine — register IP+port with Triton GCC project)
# VPS_PUBLIC_IP=144.202.12.134
# SHREDSTREAM_UDP_PORT=8002
# SHREDSTREAM_BIND_HOST=0.0.0.0

# Bot wallet (server-side signing) — path to keypair JSON, never commit
BOT_KEYPAIR_PATH=./keypair.json

# Competition wallet pubkey (for display / validation)
COMPETITION_WALLET_PUBKEY=iamaaZQHyc1FZkaqCFKhDuSt5JyLZYbveHUkAcWyFoA

# Web — dashboard talks to local API only
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_WS_URL=ws://localhost:8787/ws
# Browser wallet uses free public RPC (do NOT put Helius here)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
